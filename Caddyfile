# Caddyfile for ThesisLedger
#
# Reverse proxy configuration with automatic HTTPS (Let's Encrypt)
# Routes traffic to Next.js frontend and Django backend
#
# Environment setup (.env required):
# - DOMAIN: e.g., thesisledger.example.com
# - FRONTEND_UPSTREAM: e.g., http://localhost:3000 or http://frontend:3000
# - BACKEND_UPSTREAM: e.g., http://localhost:8000 or http://backend:8000
# - ACME_EMAIL: e.g., admin@example.com (for Let's Encrypt)

{$DOMAIN:localhost} {
	# Global options
	encode gzip
	log {
		format json
		level info
	}

	# Health check endpoint (for load balancers / monitoring)
	handle /health {
		respond 200 "OK"
	}

	# API routes → Django backend
	handle_path /api/* {
		# Remove /api prefix before forwarding
		reverse_proxy {$BACKEND_UPSTREAM:http://localhost:8000} {
			# Preserve original host and scheme for Django
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}

			# Timeout settings (adjust if needed)
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
				expect_continue_timeout 1s
			}
		}
	}

	# Static files and assets
	handle /static/* {
		reverse_proxy {$BACKEND_UPSTREAM:http://localhost:8000} {
			header_up Host {host}
		}
	}

	# Django admin panel
	handle /admin* {
		reverse_proxy {$BACKEND_UPSTREAM:http://localhost:8000} {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Root and all other routes → Next.js frontend
	handle {
		reverse_proxy {$FRONTEND_UPSTREAM:http://localhost:3000} {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}

			# WebSocket support (if Next.js uses it)
			header_up Connection upgrade
			header_up Upgrade websocket
		}
	}
}

