# Caddyfile for ThesisLedger
#
# Reverse proxy with automatic HTTPS (Let's Encrypt).
# Routes traffic to the Next.js frontend and the Django backend.
#
# Environment setup (.env required):
# - DOMAIN: e.g., thesisledger.example.com
# - FRONTEND_UPSTREAM: e.g., http://frontend:3000
# - BACKEND_UPSTREAM: e.g., http://api:8000
# - ACME_EMAIL: e.g., admin@example.com (for Let's Encrypt)

{$DOMAIN:localhost} {
	encode gzip

	log {
		output stdout
		format json
		level INFO
	}

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Health check endpoint (for load balancers / monitoring)
	handle /health {
		respond 200 "OK"
	}

	# API routes → Django. Path is NOT stripped: Django routes under /api/.
	handle /api/* {
		reverse_proxy {$BACKEND_UPSTREAM:http://api:8000} {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}

			transport http {
				dial_timeout 5s
				response_header_timeout 30s
				expect_continue_timeout 1s
			}
		}
	}

	# Django static files
	handle /static/* {
		reverse_proxy {$BACKEND_UPSTREAM:http://api:8000} {
			header_up Host {host}
		}
	}

	# Django admin panel
	handle /admin* {
		reverse_proxy {$BACKEND_UPSTREAM:http://api:8000} {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Root and all other routes → Next.js frontend
	handle {
		reverse_proxy {$FRONTEND_UPSTREAM:http://frontend:3000} {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}
}

