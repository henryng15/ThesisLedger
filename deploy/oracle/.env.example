# Oracle inference node configuration.
# Copy to .env on the VM and fill in. Never commit the real file.

# Domain pointing at this VM's public IP. If you have no domain, sslip.io works
# and Let's Encrypt will issue for it: 163.192.126.222.sslip.io
DOMAIN=

# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=

# Shared secret the API sends as "Authorization: Bearer <token>".
# Generate with:  openssl rand -hex 32
# The same value goes in Railway as OLLAMA_TOKEN.
OLLAMA_TOKEN=
