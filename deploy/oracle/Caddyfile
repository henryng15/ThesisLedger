# TLS + bearer token in front of Ollama.
#
# Ollama has no auth of its own, so it cannot be exposed directly — an open
# 11434 lets anyone run inference on this box or delete its models. Caddy is
# the cheapest thing that fixes that: automatic HTTPS, one token check, and
# only the endpoints the app actually calls.

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	@allowed {
		header Authorization "Bearer {$OLLAMA_TOKEN}"
		path /api/embeddings /api/chat /api/tags
	}

	handle @allowed {
		reverse_proxy ollama:11434
	}

	handle {
		respond 401
	}
}
