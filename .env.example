# Copy to .env and adjust. Never commit .env.

# --- Django ---
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
LOG_LEVEL=INFO

# --- Postgres (pgvector) ---
POSTGRES_DB=thesisledger
POSTGRES_USER=thesisledger
POSTGRES_PASSWORD=thesisledger
POSTGRES_HOST=localhost
# 5434 avoids clashing with a Postgres already installed on the host
POSTGRES_PORT=5434

# --- Redis (Celery broker + cache, Day 9) ---
REDIS_PASSWORD=redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Frontend ---
DOMAIN=localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
BACKEND_UPSTREAM=http://localhost:8000
FRONTEND_UPSTREAM=http://localhost:3000

# --- LLM / embeddings (Ollama local, Day 5+) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# --- LLM fallback provider (swap one var, Day 5+) ---
LLM_PROVIDER=ollama
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Caddy / Let's Encrypt (production) ---
ACME_EMAIL=admin@example.com

# --- SEC ingestion (EDGAR requires a contact User-Agent) ---
SEC_USER_AGENT=ThesisLedger/0.1 (your.email@example.com)
